generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Bucket {
  ACTIVE
  POTENTIAL
}

enum CycleCadence {
  MONTHLY
  QUARTERLY
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(USER)
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  projects      Project[]
  notesAuthored AdvisorNote[]   @relation("AuthoredNotes")
  notesReceived AdvisorNote[]   @relation("TargetNotes")
  scores        ProjectScore[]
  timePlans     TimePlan[]
  auditLogs     AuditLog[]
}

model Profile {
  id                     String  @id @default(cuid())
  userId                  String  @unique
  weeklyHoursAvailable    Int     @default(40)
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String
  bucket      Bucket
  status      String
  userRole    String
  horizon     String
  isNogo      Boolean        @default(false)
  nogoReason  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores      ProjectScore[]
  notes       AdvisorNote[]

  @@index([userId])
}

model ReviewCycle {
  id         String       @id @default(cuid())
  label      String       @unique
  cadence    CycleCadence
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean      @default(false)
  locked     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  scores     ProjectScore[]
  timePlans  TimePlan[]
  notes      AdvisorNote[]
}

model ProjectScore {
  id                String     @id @default(cuid())
  userId             String
  projectId          String
  cycleId            String
  profitability      Float
  growth             Float
  positioning        Float
  leverage           Float
  riskFavorable      Float
  timeEfficiency     Float
  purpose            Float
  energy             Float
  reputation         Float
  relationships      Float
  autonomy           Float
  governanceAdjust   Float
  totalScore         Float
  category           String
  recommendation     String
  isTrap             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycle              ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([projectId, cycleId])
  @@index([userId, cycleId])
}

model TimePlan {
  id                 String   @id @default(cuid())
  userId             String
  cycleId            String
  corePct            Int
  priorityPct        Int
  tacticalPct        Int
  opportunisticPct   Int
  distractorPct      Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle              ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId])
}

model AdvisorNote {
  id          String      @id @default(cuid())
  authorId    String
  targetUserId String
  projectId   String?
  cycleId     String?
  content     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  author      User        @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser  User        @relation("TargetNotes", fields: [targetUserId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycle       ReviewCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String
  action      String
  entity      String
  entityId    String
  payload     Json
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
